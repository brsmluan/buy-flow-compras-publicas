# =============================================================================
# BUY-FLOW - Variáveis de Ambiente
# =============================================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA OS VALORES
# NUNCA COMITE O ARQUIVO .env REAL!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Buy-Flow"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Supabase/Neon/Railway/Local)
# -----------------------------------------------------------------------------
# Formato: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buy_flow?schema=public"

# Para Supabase (produção gratuita):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"

# -----------------------------------------------------------------------------
# REDIS (Cache, Sessions, BullMQ Queue)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Para Upstash (produção gratuita):
# REDIS_URL="redis://default:[TOKEN]@[ENDPOINT].upstash.io:6379"

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT Secret (gere com: openssl rand -base64 64)
JWT_SECRET="your-super-secret-jwt-key-min-64-chars-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-64-chars-different-from-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt rounds (12 = seguro, 10 = mais rápido dev)
BCRYPT_ROUNDS=12

# 2FA / MFA
TOTP_ISSUER="Buy-Flow"
TOTP_WINDOW=1

# -----------------------------------------------------------------------------
# MULTI-TENANCY
# -----------------------------------------------------------------------------
# Domínio base para subdomínios de tenants (ex: boa-nova.buyflow.app)
TENANT_DOMAIN="localhost"
TENANT_SUBDOMAIN_ENABLED="false"

# -----------------------------------------------------------------------------
# EMAIL (Resend - 3000 emails/mês grátis)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Buy-Flow <noreply@seudominio.com>"
EMAIL_REPLY_TO="suporte@seudominio.com"

# Alternativa: SMTP (Gmail, SendGrid, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# FILE STORAGE (MinIO Local / S3 / Cloudflare R2 / Supabase Storage)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="minio"
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="buy-flow"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"

# Para S3/R2:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_BUCKET="buy-flow"
# S3_REGION="auto"

# -----------------------------------------------------------------------------
# PNCP INTEGRATION (Portal Nacional de Contratações Públicas)
# -----------------------------------------------------------------------------
PNCP_BASE_URL="https://pncp.gov.br/api"
PNCP_CLIENT_ID="seu-client-id"
PNCP_CLIENT_SECRET="seu-client-secret"
PNCP_WEBHOOK_SECRET="webhook-secret-para-validacao"

# -----------------------------------------------------------------------------
# GOV.BR INTEGRATION (Login único + Assinatura Digital)
# -----------------------------------------------------------------------------
GOVBR_CLIENT_ID="seu-client-id"
GOVBR_CLIENT_SECRET="seu-client-secret"
GOVBR_REDIRECT_URI="http://localhost:3000/auth/govbr/callback"
GOVBR_SCOPE="openid email phone cpf cnpj"
GOVBR_DISCOVERY_URL="https://sso.acesso.gov.br/.well-known/openid-configuration"

# -----------------------------------------------------------------------------
# TCE/TCM INTEGRATION (Prestação de Contas - varia por estado)
# -----------------------------------------------------------------------------
TCE_WEBSERVICE_URL="https://webservice.tce.ba.gov.br"
TCE_CERT_PATH="./certs/tce.p12"
TCE_CERT_PASSWORD="senha-do-certificado"

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN="https://xxx@sentry.io/xxx"
LOG_LEVEL="debug"
LOG_PRETTY="true"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_PWA_ENABLED="true"
FEATURE_REALTIME_ENABLED="true"
FEATURE_AI_ASSISTANT_ENABLED="true"
FEATURE_DOC_GENERATION_ENABLED="true"
FEATURE_PNCP_SYNC_ENABLED="true"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# UPLOAD LIMITS
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"