{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@buy-flow/shared": ["../shared/dist"],
      "@buy-flow/shared/types": ["../shared/dist/types.d.ts"],
      "@buy-flow/shared/constants": ["../shared/dist/constants.d.ts"],
      "@buy-flow/shared/validators": ["../shared/dist/validators.d.ts"],
      "@/*": ["src/*"],
      "@/lib/*": ["src/lib/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/modules/*": ["src/modules/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
