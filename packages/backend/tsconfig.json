{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@buy-flow/shared/*": ["../shared/src/*"],
      "@/*": ["src/*"],
      "@/lib/*": ["src/lib/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/modules/*": ["src/modules/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}